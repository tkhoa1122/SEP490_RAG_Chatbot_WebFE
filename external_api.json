{
    "openapi": "3.0.1",
    "info": {
        "title": "Smart Shopping ChatBot API",
        "description": "API documentation for Smart Shopping ChatBot\n\n\nDefinition and Acronyms: \n\n- BO: Business Owner\n\n- CT: Catalog Team",
